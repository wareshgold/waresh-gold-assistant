{
  "name": "waresh-gold-assistant",

  "main": "src/index.ts",

  "compatibility_date": "2026-07-17",

  "observability": {
    "enabled": true
  },


  "kv_namespaces": [
    {
      "binding": "MARKET_CACHE",
      "id": "5b44d51427934e729dc0372d198487eb"
    }
  ],


  "d1_databases": [
    {
      "binding": "waresh_gold_db",
      "database_name": "waresh-gold-db",
      "database_id": "6685270e-8e5b-4af9-ac65-f2360fe70af8"
    }
  ],


  "vars": {

    "ENVIRONMENT": "production",

    "MARKET_PRICE_API_URL": "https://example.com/api/price",

    "TELEGRAM_MARKET_SOURCE_URL": "https://t.me/s/ecogold_ir"

  },


  "triggers": {

    "crons": [
      "*/30 4-17 * * *"
    ]

  }

}